# NyayaFlow AI - Environment Configuration Example
# Copy this file to .env in the project root or backend folder if configuring optional services.

# Optional: Google Gemini API Key for dynamic procedural explanations.
# If omitted or left empty, the application functions 100% locally using deterministic template explanations.
GEMINI_API_KEY=

# Local SQLite Database URL (defaults to data/nyayaflow.db)
# DATABASE_URL=sqlite:///../data/nyayaflow.db
